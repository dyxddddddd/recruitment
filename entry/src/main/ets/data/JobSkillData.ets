/**
 * 根据岗位名称返回完整候选技能池（末尾均有"其他"）。
 * 精确命中则直接返回，否则关键词回退拼接，都失败返回空数组。
 */
export function querySkillsByJobTitle(title: string): string[] {
  if (!title || title.trim().length === 0) {
    return []
  }
  const direct = MAP[title]
  if (direct) {
    return direct
  }
  // 关键词回退
  const titleLower = title.toLowerCase()
  const keys = Object.keys(MAP)
  const matched = new Set<string>()
  for (let i = 0; i < keys.length; i++) {
    const kw = keys[i]
    if (titleLower.indexOf(kw.toLowerCase()) >= 0 || kw.toLowerCase().indexOf(titleLower) >= 0) {
      const skills = MAP[kw]
      for (let j = 0; j < skills.length; j++) {
        matched.add(skills[j])
      }
    }
  }
  if (matched.size > 0) {
    const result = Array.from(matched)
    if (result.indexOf('其他') < 0) {
      result.push('其他')
    }
    return result
  }
  return []
}
